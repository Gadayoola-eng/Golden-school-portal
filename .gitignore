# Cache & temporary files
.vite/
client/.vite/
.cache/
server/.cache/
coverage/
.nyc_output/

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
